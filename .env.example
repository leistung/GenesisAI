# ============================================================
# GenesisAI 环境变量模板
# ============================================================
# 使用方法：复制本文件为 .env.local，然后填入真实值
#   cp .env.example .env.local
#
# 安全须知：
#   - .env.local 包含密钥和敏感配置，永远不要提交到 git
#   - 本仓库 .gitignore 已忽略 .env*（除了 .env.example）
#   - 所有 AI 模型 API Key、Google OAuth、支付密钥等都必须从环境变量读取
# ============================================================

# ---------- 数据库 ----------
# 本地开发（Docker PostgreSQL）
DATABASE_URL="postgresql://genesis_user:genesis_password@localhost:5433/genesisai"
# 生产环境示例（Neon / Supabase / RDS）
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ---------- NextAuth v5 ----------
# 生成命令：openssl rand -base64 32
AUTH_SECRET=""
# 应用基础 URL（影响回调、邮件链接、支付回调）
AUTH_URL="http://localhost:3000"

# ---------- Google OAuth ----------
# 申请地址：https://console.cloud.google.com/apis/credentials
# 授权回调 URI：http://localhost:3000/api/auth/callback/google
# 生产回调：https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# 中国大陆开发 Google 登录需要给 Node.js 配置 HTTP 代理（如 Clash/V2Ray）
# 海外服务器/本地网络可直接留空
HTTPS_PROXY=""

# ---------- Creem 支付 ----------
# 申请地址：https://creem.io
# Webhook 地址：https://your-domain.com/api/creem/webhook
CREEM_API_KEY=""
CREEM_WEBHOOK_SECRET=""

# ---------- AI 服务 ----------
# 可选 provider：placeholder | dashscope | openai | stability | replicate
AI_PROVIDER="placeholder"
# 阿里云 DashScope / 百炼：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=""
# OpenAI：https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# Stability AI：https://platform.stability.ai/account/keys
STABILITY_API_KEY=""
# Replicate：https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=""

# ---------- Upstash Redis（生产限流，可选）----------
# 申请地址：https://console.upstash.com
# 不配置时使用内存限流（仅适合单进程开发）
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------- S3/R2 对象存储（图片持久化，可选）----------
# 推荐 Cloudflare R2（免费额度大）：https://dash.cloudflare.com
# 或 AWS S3 / MinIO / 阿里云 OSS
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="genesisai-images"
S3_REGION="auto"
# 公开访问域名（CDN 或 bucket 公开域名）
S3_PUBLIC_URL=""

# ---------- 邮件服务（邮箱验证，可选）----------
# 推荐 Resend：https://resend.com（每月 3000 封免费）
# 不配置时跳过邮件发送（开发环境可在日志中查看验证链接）
RESEND_API_KEY=""
MAIL_FROM="GenesisAI <noreply@genesisai.com>"
