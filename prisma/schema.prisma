// Prisma Schema for AI Image Generator
// Database: PostgreSQL (production) / SQLite (development)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// User model - linked to NextAuth
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  password      String?   // For credentials (email/password) auth
  role          String    @default("user") // "user" or "admin"
  
  // Credits system
  credits       Int       @default(10)  // Free tier: 10 credits/day
  creditsResetAt DateTime @default(now()) // Daily reset timestamp
  
  // Subscription
  subscriptionTier String?  // 'free', 'premium', 'ultimate'
  creemCustomerId String?  @unique // Creem customer ID
  creemSubscriptionId String? @unique // Creem subscription ID
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  images        Image[]
  orders        Order[]
  bookmarks     Bookmark[]
  likes         Like[]
  comments      Comment[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Generated images
model Image {
  id              String   @id @default(cuid())
  userId          String?
  prompt          String
  negativePrompt  String?
  model           String
  aspectRatio     String
  style           String?
  color           String?
  lighting        String?
  composition     String?
  imageUrl        String
  thumbnailUrl    String?
  referenceImage  String?   // Base64 data URL of the uploaded reference image
  isPublic        Boolean   @default(false)
  likes           Int       @default(0)
  
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookmarks       Bookmark[]
  likeRecords     Like[]
  comments        Comment[]

  createdAt       DateTime  @default(now())
}

// Orders for Creem payments
model Order {
  id              String   @id @default(cuid())
  userId          String
  creemOrderId    String   @unique // Creem order ID
  creemTransactionId String? // Creem transaction ID
  status          String   @default("pending") // pending, completed, failed, refunded
  amount          Float
  currency        String   @default("USD")
  creditsAdded    Int      // How many credits this order adds
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Pricing plans (seeded data)
model Plan {
  id              String   @id @default(cuid())
  name            String   @unique // 'free', 'premium', 'ultimate'
  displayName     String
  price           Float
  currency        String   @default("USD")
  credits         Int      // Credits per month
  creemProductId  String?  @unique // Creem product ID for checkout
  features        String   // JSON string of features list
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Image likes (track who liked what)
model Like {
  id        String   @id @default(cuid())
  userId    String
  imageId   String
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  image     Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([userId, imageId])
}

// Image bookmarks (favorites)
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  imageId   String
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  image     Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([userId, imageId])
}

// Comments on images
model Comment {
  id        String   @id @default(cuid())
  userId    String
  imageId   String
  content   String
  parentId  String?  // For replies: references another Comment's id
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  image     Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// AI Model configurations (admin configurable)
model AIModel {
  id            String   @id @default(cuid())
  name          String   @unique // e.g. "qwen-image-edit", "wanx-v3"
  displayName   String   // e.g. "Qwen Image Edit", "Wanx v3"
  provider      String   @default("dashscope") // "dashscope", "openai", "stability", "replicate"
  baseUrl       String   // API base URL
  apiKey        String   // API key (encrypted in production)
  modelId       String   // Model ID for API calls
  creditsCost   Int      @default(1) // Credits consumed per generation
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0) // Display order
  
  // Model capabilities
  supportsTextToImage Boolean @default(true)
  supportsImageEdit   Boolean @default(false)
  supportsNegativePrompt Boolean @default(true)
  maxPromptLength     Int     @default(2000)
  
  // Supported aspect ratios (JSON array string)
  supportedAspectRatios String @default("[\"1:1\",\"16:9\",\"9:16\",\"4:3\",\"3:4\"]")
  
  // Style-specific system prompts (JSON object string, keyed by style name)
  stylePrompts  String   @default("{}")
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
